# ── paper-finder 环境变量模板 ──────────────────────────
# 复制为 .env 后填写。.env 已在 .gitignore 中，绝不要提交。

# ── arXiv：必需，但完全免费、无需 key ──────────────────
# 只需提供一个联系邮箱（放在 User-Agent 里，符合 arXiv 使用规范）
ARXIV_CONTACT_EMAIL=you@university.edu

# ── OpenAlex：可选，但"顶会口径"下强烈建议 ─────────────
# 2026-10-30 复测：无 key 也能用（摘要/venue/DOI 齐全），只是只能浅翻
# （每本会议最多 200 条/页 × 若干页），且配额是"同网段共享"，
# 429 时本轮自动降级、不影响其他源。有 key 能深翻 + 30 req/s。
#
# 申请方式（用真实邮箱，之后点邮件里的激活链接）：
#   curl -X POST https://api.openalex.org/api-keys \
#     -H "Content-Type: application/json" \
#     -d '{"email":"you@university.edu","agent":"Codex"}'
OPENALEX_API_KEY=

# ── Semantic Scholar：可选增强 ────────────────────────
# 实测无 key 同样 429。申请：https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=

# ── Unpaywall：用于取开放获取全文链接 ──────────────────
# 必须填真实邮箱，官方会拒绝占位邮箱（实测返回 422）
UNPAYWALL_EMAIL=

# ── LLM 精排（L2）────────────────────────────────────
# 不填也能用：简报会标注"L1-only 粗筛"。填了才会做语义精排（按 rubric 打分）。
# L2 用便宜模型批量跑摘要即可。
LLM_API_KEY=
LLM_MODEL_CHEAP=
LLM_MODEL_STRONG=
# 兼容 OpenAI 协议的服务都行（如 DeepSeek、通义、vLLM 本地部署）
LLM_BASE_URL=

# ── 运行时 ─────────────────────────────────────────
PAPER_FINDER_DB=./data/papers.db
# 默认 profile，可被 --profile 覆盖
PAPER_FINDER_PROFILE=ai-vuln-discovery
# 日报副本目录（相对仓库根或绝对路径）。留空则不拷。
# 想每天同步到网盘/笔记库时填这里。
PAPER_FINDER_DIGEST_DIR=

# ── 代理（可选）──────────────────────────────────────
# 若 arXiv/OpenAlex 需要走代理：
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
