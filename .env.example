# ── paper-finder 环境变量模板 ──────────────────────────
# 复制为 .env 后填写。.env 已在 .gitignore 中，绝不要提交。

# ── arXiv：必需，但完全免费、无需 key ──────────────────
# 只需提供一个联系邮箱（放在 User-Agent 里，符合 arXiv 使用规范）
ARXIV_CONTACT_EMAIL=you@university.edu

# ── OpenAlex：强烈建议 ────────────────────────────────
# 实测：无 key 时返回 429「Insufficient budget」（每日预算被同 IP 的所有人共享），
# 且 cursor paging 翻页必须有 key（否则只能拿第一页）。
# 免费 key 可 10× 预算（$1/天）、30 req/s。
#
# 申请方式（agent 可一键完成，需用真实邮箱，之后点邮件里的激活链接）：
#   curl -X POST https://api.openalex.org/api-keys \
#     -H "Content-Type: application/json" \
#     -d '{"email":"you@university.edu","agent":"Codex"}'
OPENALEX_API_KEY=

# ── Semantic Scholar：可选增强 ────────────────────────
# 实测无 key 同样 429。申请：https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=

# ── Unpaywall：用于取开放获取全文链接 ──────────────────
# 必须填真实邮箱，官方会拒绝占位邮箱（实测返回 422）
UNPAYWALL_EMAIL=

# ── LLM 精排（Phase 2 才需要）────────────────────────
# L2 用便宜模型批量跑摘要，L3 深读才用好模型
LLM_API_KEY=
LLM_MODEL_CHEAP=
LLM_MODEL_STRONG=

# ── 运行时 ─────────────────────────────────────────
PAPER_FINDER_DB=./data/papers.db
PAPER_FINDER_PROFILE=llm-speech-security
