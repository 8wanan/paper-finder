# ── 凭证：绝不提交 ──────────────────────────────
.env
.env.*
!.env.example
*.key
credentials.json

# ── 本地账本：体积大且含个人判定，不提交 ──────────
data/*.db
data/*.db-journal
data/*.sqlite3
python-version

# ── 但冷启动普查数据要提交（可复现的种子）─────────
!data/seed-census.json

# ── 全文 PDF：版权风险，绝不提交 ────────────────
pdfs/
*.pdf

# ── 运行产物 ──────────────────────────────────
briefs/
*.brief.md
runs/
# agent 写的一句话简介（属于个人判断，不进版本库）
data/*.jsonl

# 每日任务的日志（含抓取进度，体积不大但没必要进版本库）
logs/
*.log

# ── 真实金标集：含你的研究判断，绝不提交 ────────────
# 金标集记录了你认为"哪些是必读"以及你的 why 备注 —— 那是你的研究品味，
# 不是工具的一部分。别人也用不上（每个人的判断不同，无法共享）。
# 只提交脱敏的模板 tests/golden.example.yaml。
# 注意：早期版本的 .gitignore 漏了这两行，实测会导致 `git add -A`
# 把 golden.yaml 一起提交上去。
tests/golden.yaml
tests/golden-*.yaml
!tests/golden.example.yaml

# ── 测试临时目录（必须放仓库内：沙箱常禁止在系统 Temp 建 SQLite 文件）──
tests/.tmp/

# ── Python ───────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ── 编辑器 / 系统 ─────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
